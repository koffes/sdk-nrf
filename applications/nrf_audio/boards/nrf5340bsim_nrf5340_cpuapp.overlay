/* BabbleSim models no LEDs or buttons; these virtual GPIOs let the unmodified app build and run. */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	audioleds: audioleds {
		compatible = "gpio-leds";
		status = "okay";

		led_device_type: led_device_type {
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			label = "Device type LED";
		};

		led_conn_status: led_conn_status {
			gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>;
			label = "Connection status LED";
		};

		led_app_status: led_app_status {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "App status LED";
		};

		led_sync_status: led_sync_status {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
			label = "Sync status LED";
		};
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";

		led0: led_0 {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
			label = "LED 0";
		};

		led1: led_1 {
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
			label = "LED 1";
		};

		led2: led_2 {
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
			label = "LED 2";
		};

		led3: led_3 {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "LED 3";
		};
	};

	buttons {
		compatible = "gpio-keys";
		status = "okay";

		button0: button_0 {
			gpios = <&gpio0 0 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Volume down";
		};

		button1: button_1 {
			gpios = <&gpio0 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Volume up";
		};

		button2: button_2 {
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Play/pause";
		};

		button3: button_3 {
			gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 4";
		};

		button4: button_4 {
			gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Button 5";
		};
	};

	aliases {
		sw0 = &button0;
		sw1 = &button1;
		sw2 = &button2;
		sw3 = &button3;
		sw4 = &button4;
	};
};
